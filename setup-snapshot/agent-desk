#!/usr/bin/env python3
"""Open Empryo in a project using the desktop's existing launcher and terminal."""
from pathlib import Path
import argparse
import os
import subprocess

home = Path.home()
p = argparse.ArgumentParser()
p.add_argument('project', nargs='?', type=Path)
p.add_argument('--list', action='store_true')
args = p.parse_args()
projects = sorted(x for x in (home/'Projects').iterdir() if x.is_dir() and '\n' not in x.name)
if args.list:
    print('\n'.join(str(x) for x in projects))
    raise SystemExit(0)
project = args.project
if project is None:
    labels = [x.name for x in projects]
    menu = home/'.local/opt/rofi-quiet/bin/rofi'
    result = subprocess.run([str(menu),'-dmenu','-i','-p','Agent workspace'], input='\n'.join(labels),text=True,capture_output=True)
    if result.returncode: raise SystemExit(0)
    choice = result.stdout.strip()
    if choice not in labels: raise SystemExit('Select an existing workspace.')
    project = projects[labels.index(choice)]
project = project.expanduser().resolve()
if not project.is_dir(): raise SystemExit(f'Not a directory: {project}')
os.execvp('kitty',['kitty','--class','empryo','--title',f'Empryo · {project.name}','--directory',str(project),str(home/'.empryo/bin/empryo')])
