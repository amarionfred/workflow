#!/bin/sh
set -eu
AGSCI_WORKSPACE=/home/park/Projects/agentic-workflow/vendor/AI-Scientist-v3
AGENTIC_TEMP_ROOT=/home/park/.local/state/agentic-workflow/scientist-tmp
export AGENTIC_TEMP_ROOT
PATH=/home/park/Projects/agentic-workflow/tools/scientist-bin:$PATH
export PATH
mkdir -p "$AGENTIC_TEMP_ROOT"
chmod 700 "$AGENTIC_TEMP_ROOT"
cd "$AGSCI_WORKSPACE"
case "${1:-help}" in
  preview) shift; exec .venv/bin/agsci run examples/circpack --dry-run agent.name=codex agent.model=gpt-6-astra container.env_file= "$@" ;;
  doctor) shift; exec .venv/bin/agsci doctor examples/circpack agent.name=codex agent.model=gpt-6-astra container.env_file= "$@" ;;
  run) shift; AGSCI_TASK=${1:?Provide a task directory}; shift; exec .venv/bin/agsci run "$AGSCI_TASK" agent.name=codex agent.model=gpt-6-astra container.env_file= "$@" ;;
  *) exec .venv/bin/agsci "$@" ;;
esac
