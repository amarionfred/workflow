#!/usr/bin/env python3
"""Map Sakana's host UID to container root in the dedicated rootless context.

Container UID 0 maps to Park on the host. The upstream pipeline passes the
host UID verbatim, which instead maps to a subordinate UID in rootless Docker.
This adapter only changes that exact explicit user pair on run/exec; all
isolation, mounts, network, and resource flags remain upstream-owned.
"""
import os
import json
import subprocess
import sys

args = sys.argv[1:]
identity = f'{os.getuid()}:{os.getgid()}'
binary = '/home/park/.local/opt/docker-rootless/bin/docker'
# Sakana gives package installers a temporary HOME. Resolve this dedicated
# context from Park's fixed Docker configuration rather than that temp home.
prefix = [binary, '--config', '/home/park/.docker', '--context', 'rootless']
env = dict(os.environ)
for key in ('DOCKER_HOST', 'DOCKER_CONTEXT', 'DOCKER_CONFIG'):
    env.pop(key, None)
if args and args[0] in {'run', 'exec'}:
    probe = subprocess.run([*prefix,'info','--format','{{json .SecurityOptions}}'],env=env,capture_output=True,text=True,timeout=15)
    if probe.returncode or not any('rootless' in item for item in json.loads(probe.stdout)):
        raise SystemExit('Scientist UID mapping requires a verified rootless Docker daemon.')
    for index, value in enumerate(args):
        if value in {'--user', '-u'} and index+1 < len(args) and args[index+1] == identity:
            args[index+1] = '0:0'
            break
        if value == '--user='+identity:
            args[index] = '--user=0:0'
            break
os.execve(binary, [*prefix, *args], env)
